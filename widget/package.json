{
  "name": "traffic-light-widget",
  "version": "2.0.0",
  "private": true,
  "description": "Electron desktop traffic-light widget for AI agent status monitoring",
  "author": "Agent Tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "cd ..\\hooks-bridge && npm install --omit=dev && cd ..\\widget",
    "build": "electron-builder",
    "build:all": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.8.1",
    "jimp": "^1.6.1"
  },
  "build": {
    "appId": "com.agent.traffic-light",
    "productName": "AgentTrafficLight",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../hooks-bridge",
        "to": "hooks-bridge",
        "filter": ["**/*", "!state/**", "!*.log"]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent Traffic Light"
    },
    "portable": {
      "artifactName": "AgentTrafficLight-${version}-portable.${ext}"
    }
  }
}
