{
  "name": "traffic-light-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop traffic-light widget",
  "author": "Cursor Tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.8.1",
    "jimp": "^1.6.1"
  },
  "build": {
    "appId": "com.cursor.traffic-light",
    "productName": "Cursor Traffic Light",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cursor Traffic Light"
    },
    "portable": {
      "artifactName": "CursorTrafficLight-${version}-portable.${ext}"
    }
  }
}
